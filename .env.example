# Copy to .env.local (never commit real values). Names match what the code reads.
# --- Required ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# --- Server-side (API routes / scripts) ---
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
DIRECT_URL=
GEMINI_API_KEY=
INTERNAL_API_KEY=
SYNC_API_SECRET=
GOOGLE_SHEET_ID=
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
NEXT_PUBLIC_APP_URL=
# --- Monitoring (was hardcoded; optional, Sentry is off when unset) ---
NEXT_PUBLIC_SENTRY_DSN=
# --- English test Google Forms ---
NEXT_PUBLIC_PRETEST_FORM_URL=
NEXT_PUBLIC_PRETEST_ENTRY_ID=
NEXT_PUBLIC_POSTTEST_FORM_URL=
NEXT_PUBLIC_POSTTEST_ENTRY_ID=
# --- New dashboard (optional) ---
NEXT_PUBLIC_SHOW_DEMO_DATA=
NEXT_PUBLIC_TOFLY_URL=
NEXT_PUBLIC_SKILIO_URL=
NEXT_PUBLIC_CIRCLE_WHATSAPP_URL=
# --- Elco AI link (optional; default https://ai.ielsco.com) ---
NEXT_PUBLIC_ELCO_URL=
# --- Redirect safety: extra trusted hosts besides ielsco.com, www., school., circle. (comma-separated, server-only) ---
TRUSTED_HOSTS=
# --- Elco AI account linking (Phase 5; server-only; docs/INTEGRATION-API.md) ---
# Two different random secrets, at least 32 characters each, e.g. `openssl rand -base64 48`.
# The same two values go into the Elco API's env. Rotation: "new,old" (sign with new, accept both).
ELCO_TO_IELSCO_SECRET=
IELSCO_TO_ELCO_SECRET=
# Elco API base URL for IELSco -> Elco calls (unlink notifications), e.g. https://api.ai.ielsco.com
ELCO_API_URL=
# --- Membership + Midtrans (docs/MEMBERSHIP-PLATFORM.md; server-only unless NEXT_PUBLIC_) ---
MEMBERSHIP_CHECKOUT_ENABLED=
MIDTRANS_ENV=sandbox
MIDTRANS_SANDBOX_SERVER_KEY=
MIDTRANS_SANDBOX_CLIENT_KEY=
MIDTRANS_PRODUCTION_SERVER_KEY=
MIDTRANS_PRODUCTION_CLIENT_KEY=
MIDTRANS_PRODUCTION_ENABLED=
# "true" only after the owner approves the prices in public.membership_plans
NEXT_PUBLIC_MEMBERSHIP_PRICES_PUBLIC=
# "true" once Vercel Web Analytics is switched on for the project
NEXT_PUBLIC_ANALYTICS_ENABLED=
