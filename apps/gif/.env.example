# GIF platform (apps/gif) — copy to .env.local for local development. Never commit real values.
# Production values go in the Vercel project's Environment Variables (see docs/gif-platform/DEPLOYMENT.md).

# Database: Supabase transaction-pooler URL (port 6543) for the IELSco project; the app uses schema "gif".
GIF_DATABASE_URL=postgres://USER:PASSWORD@HOST:6543/postgres
# Optional: CA certificate to verify the database TLS certificate (PEM, \n-escaped).
GIF_DATABASE_CA_CERT=
GIF_DATABASE_POOL_MAX=5

# Sessions and sign-in codes: 32+ random characters (e.g. `openssl rand -base64 48`).
GIF_AUTH_SECRET=
GIF_SITE_URL=https://gif.ielsco.com
# Set to true on previews so they are not indexed.
GIF_NOINDEX=

# Private file storage (Supabase Storage bucket "gif-applications", created by the migration).
GIF_STORAGE_DRIVER=supabase
GIF_SUPABASE_URL=https://hkubzamchahvdpvojepc.supabase.co
GIF_SUPABASE_SERVICE_ROLE_KEY=

# Email (Resend). Without these, emails are recorded in gif.email_outbox as "logged" but not sent.
RESEND_API_KEY=
GIF_EMAIL_FROM="IELSco GIF <gif@ielsco.com>"
GIF_EMAIL_REPLY_TO=hello@ielsco.com
GIF_FINANCE_EMAIL=hello@ielsco.com

# Payments (Midtrans). Off unless GIF_PAYMENTS_ENABLED=true. Start with sandbox.
GIF_PAYMENTS_ENABLED=false
GIF_MIDTRANS_ENV=sandbox
GIF_MIDTRANS_PRODUCTION_ENABLED=false
GIF_MIDTRANS_SERVER_KEY=
GIF_MIDTRANS_CLIENT_KEY=
# Dashboard → Settings → Access Keys → "Signature Secret Key" (since 28 Oct 2026). Comma-separate old,new during rotation.
GIF_MIDTRANS_SIGNATURE_KEYS=

# Vercel Cron authorisation (/api/cron/daily). 16+ random characters.
CRON_SECRET=
